# Copy this file to .env and fill in your keys.
# Never commit .env.

# Groq API key: https://console.groq.com/keys
GROQ_API_KEY=

# Tavily API key: https://app.tavily.com/home
TAVILY_API_KEY=

# Optional overrides
# Default is a Groq model with local tool-calling support.
GROQ_MODEL=openai/gpt-oss-120b
# Results per search (1-10).
TAVILY_MAX_RESULTS=5
# Maximum agent graph steps (6-60).
AGENT_MAX_STEPS=30

# --- Optional: LangSmith tracing ---
# Leave LANGSMITH_TRACING=false (or unset) to disable tracing.
# Set it to true and add a LangSmith API key to record runs at
# https://smith.langchain.com. The key is never shown in the UI.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# Traces appear under this project name.
LANGSMITH_PROJECT=web-search-research-agent
